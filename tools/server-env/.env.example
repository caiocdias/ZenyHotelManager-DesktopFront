# Variáveis do ambiente do servidor usado pelo front (projeto compose `zeny-front`). Mesmas variáveis,
# na mesma ordem, do docker/.env.example do servidor no commit fixado em api/server-pin.properties.
# O arquivo real fica em .server/zeny-front.env (ignorado pelo Git) e é gerado por gen-env.sh, que
# preenche os segredos abaixo com geradores do README do servidor:
#
#   bash tools/server-env/gen-env.sh .server/zeny-front.env
#
# Os valores preenchidos são só de desenvolvimento e não são segredos; os segredos (chaves, senha do
# admin e senhas do MinIO) ficam vazios aqui e o compose não sobe sem eles. Nunca versione o .env real.

# Profile do servidor: `prod` (logs em JSON, sem Swagger UI) ou `local` (logs legíveis e
# Swagger UI em /swagger-ui.html).
ZENY_PROFILE=prod

# Porta HTTP do proxy no host e o endereço em que ela escuta.
# - ZENY_HTTP_PORT: 8088 por padrão no front (evita a 80 e a 8080, que é a do bootRun).
# - ZENY_HTTP_ADDRESS: vazio = usa o padrão do override (compose.override.yaml): 127.0.0.1 no
#   notebook (só esta máquina) e 0.0.0.0 no pacote do Windows. Para abrir à rede (ex.: app mobile),
#   use 0.0.0.0 (ou --address 0.0.0.0 no gen-env.sh) e ajuste ZENY_STORAGE_PUBLIC_ENDPOINT abaixo.
ZENY_HTTP_PORT=8088
ZENY_HTTP_ADDRESS=

# Banco, com dois papéis (mesmos nomes e valores de desenvolvimento do profile `local`):
# - ZENY_DB_MIGRATION_*: o dono dos schemas (o POSTGRES_USER do container), usado só pelo Flyway;
# - ZENY_DB_USERNAME/ZENY_DB_PASSWORD: o papel da aplicação, criado na primeira inicialização do
#   volume, só com DML e sem UPDATE/DELETE na trilha de auditoria. Precisa ser diferente do dono.
# Num volume criado antes destes dois papéis, recrie o banco (down -v).
ZENY_DB_NAME=zeny
ZENY_DB_MIGRATION_USERNAME=zeny
ZENY_DB_MIGRATION_PASSWORD=zeny
ZENY_DB_USERNAME=zeny_app
ZENY_DB_PASSWORD=zeny_app

# Cifragem de campo: "id:base64" com 32 bytes aleatórios, gerado pelo gen-env.sh. Guarde a chave
# enquanto usar o mesmo volume do banco: o que ela cifrou só se lê com ela. Vazia, o compose não sobe.
ZENY_ENCRYPTION_KEYS=
ZENY_ENCRYPTION_ACTIVE_KEY_ID=dev

# Assinatura do access token JWT (RS256): "kid:base64" com uma chave privada RSA 3072 em PKCS#8 DER,
# gerada pelo gen-env.sh. Vazia, o compose não sobe.
ZENY_JWT_KEYS=
ZENY_JWT_ACTIVE_KEY_ID=dev

# Administrador inicial, criado só no primeiro boot (banco sem usuários) e obrigado a trocar a
# senha no primeiro login. A senha é gerada pelo gen-env.sh; guarde-a até o primeiro login.
ZENY_ADMIN_LOGIN=admin
ZENY_ADMIN_PASSWORD=

# Armazenamento de anexos (MinIO):
# - ZENY_STORAGE_ROOT_*: o root do MinIO, usado só pelo storage e pelo storage-init;
# - ZENY_STORAGE_ACCESS_KEY/ZENY_STORAGE_SECRET_KEY: o usuário de serviço da api, diferente do root.
#   Senhas geradas pelo gen-env.sh; vazias, o compose não sobe.
# - ZENY_STORAGE_BUCKET: não pode ser "api" nem "actuator".
# - ZENY_STORAGE_PUBLIC_ENDPOINT: o endereço do proxy que os clientes usam nas URLs assinadas dos
#   anexos. Vazio = padrão do override: http://localhost:<ZENY_HTTP_PORT>. Quando o app acessa por
#   outro endereço (rede, mobile), use o endereço que ele enxerga, ex.: http://<IP>:8088; senão as
#   URLs assinadas não abrem.
ZENY_STORAGE_ROOT_USER=zeny
ZENY_STORAGE_ROOT_PASSWORD=
ZENY_STORAGE_BUCKET=zeny-files
ZENY_STORAGE_ACCESS_KEY=zeny-app
ZENY_STORAGE_SECRET_KEY=
ZENY_STORAGE_PUBLIC_ENDPOINT=

# Push pelo FCM HTTP v1 (opcional). O JSON da conta de serviço do projeto Firebase do hotel, em
# base64 numa linha só. O gen-env.sh não o preenche. Vazia, o push fica desligado e só o painel de
# notificações é entregue. Nunca versione essa credencial.
ZENY_FCM_CREDENTIALS=
